            {
              "description": "Payload - JSON of the triggered object. Not supported for all delete cases.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "person",
                "id",
                "start"
              ],
              "properties": {
                "project": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
