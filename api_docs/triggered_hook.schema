                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Travel time in minutes"
                },
                "travelComment": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Travel time in minutes"
                },
                "id": {
                  "type": "string",
                  "description": "Internal ID of a time report"
                },
                "billableAmount": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Billable amount of time report"
                },
